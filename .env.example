# Primary provider (recommended). Set this to route all calls through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Fallback. Used automatically if an OpenRouter call fails, OR as the sole provider
# if OPENROUTER_API_KEY is not set. A ⚠️ fallback alert is printed to stderr each
# time a call falls over to Anthropic direct.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. If set, every completed debate transcript is ALSO copied into this
# directory (in addition to the default ./debates/ folder). Useful for piping
# transcripts into note systems like Obsidian, iCloud, OneDrive, etc.
# Example:
# DEBATE_OUTPUT_DIR=

# OpenRouter slug for the neutral nine-lens starter framing. The framing sets
# the ceiling for the whole debate, so it ships on Claude Sonnet. Drop to a
# cheaper slug (e.g. anthropic/claude-haiku-4.5) for fast/cheap runs. If unset,
# the code fallback is Haiku.
DEBATE_STARTER_MODEL=anthropic/claude-sonnet-5

# OpenRouter slug for the final synthesizer (per-persona verdicts + consensus
# model + action recommendation). The highest-value call, so it ships on Claude
# Sonnet. If unset, the code fallback is Haiku.
DEBATE_SYNTHESIZER_MODEL=anthropic/claude-sonnet-5

# OpenRouter slug for the round-1 standpoints distillation step. Cheap and
# mechanical, so it stays on Haiku even while starter/synth run on Sonnet.
# If unset, it inherits DEBATE_SYNTHESIZER_MODEL.
DEBATE_STANDPOINTS_MODEL=anthropic/claude-haiku-4.5

# Optional. Total debate rounds (round 1 parallel + R2..N sequential).
# Integer in [2, 10]; default 4. Lower values run faster but produce less
# back-and-forth; higher values deepen the debate at roughly linear cost.
# DEBATE_ROUNDS=4

# Optional. Target panel size for `--personas auto` (the default selection mode).
# Integer in [2, 12]; default 6. The selector picks this many maximally
# contrasting voices for the specific question.
# DEBATE_AUTO_PANEL_SIZE=6

# Optional. Rough per-call USD estimate used only for the Anthropic-direct
# fallback cost line in the nerdstats footer. Defaults to 0.002 (Haiku-direct
# average). Bump this if you routinely run long system prompts that push the
# fallback call cost higher.
# DEBATE_FALLBACK_EST_USD=0.002

